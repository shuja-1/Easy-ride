# Server
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/easyride

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Admin account (created automatically on first server start)
ADMIN_NAME=EasyRide Admin
ADMIN_EMAIL=admin@easyride.com
ADMIN_PASSWORD=Admin@123

# UPI demo mode (used only when Razorpay keys are empty)
UPI_ID=easyride@okaxis
UPI_NAME=EasyRide Car Rentals

# Razorpay — add your test/live keys to enable real UPI checkout
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Platform fee retained from each verified payment (percent)
PLATFORM_FEE_PERCENT=5

# Seed accounts password
DEMO_PASSWORD=Demo@123
